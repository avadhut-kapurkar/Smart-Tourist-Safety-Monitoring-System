<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/welcome_text"
        android:textSize="20sp"
        android:layout_gravity="center"
        android:layout_marginBottom="20dp"
        android:textColor="#000000" />

    <!-- 🔴 SOS -->

    <!-- Profile Button -->

    <Button
        android:id="@+id/btnSOS"
        android:layout_width="125dp"
        android:layout_height="125dp"
        android:layout_gravity="center"
        android:layout_marginBottom="30dp"
        android:backgroundTint="#FF0000"
        android:text="@string/sos"
        android:textColor="#FFFFFF"
        android:textSize="25sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnProfile"
        android:layout_width="match_parent"
        android:layout_height="77dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/black_square"
        android:text="@string/profile"
        android:textColor="#FFEEEE" />

    <!-- Row 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <Button
            android:id="@+id/btnWearable"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:backgroundTint="#000000"
            android:text="@string/wearable_contacts"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnMaps"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:backgroundTint="#000000"
            android:text="@string/map"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Row 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <Button
            android:id="@+id/btnFIR"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:backgroundTint="#000000"
            android:text="@string/fir_file"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnAI"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:backgroundTint="#000000"
            android:text="@string/ai_system"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <Button
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Logout"
        android:backgroundTint="#000000"
        android:textColor="#FFFFFF" />

</LinearLayout>