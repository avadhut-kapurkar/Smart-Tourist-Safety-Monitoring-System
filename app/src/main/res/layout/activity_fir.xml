<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Center Card -->
    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_centerInParent="true"
        android:padding="20dp"
        android:background="@drawable/fir_card_bg">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="File an FIR or Report an Incident"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <!-- Button -->
        <Button
            android:id="@+id/btnFIR"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="File Online via Maharashtra Police Portal"
            android:backgroundTint="#00E5FF"
            android:textColor="#000000"/>

        <!-- Info -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="For Immediate Police Assistance:\nDIAL 100"
            android:textColor="#00E5FF"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:textStyle="bold"/>

        <!-- Back Button -->
        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back to Dashboard"
            android:layout_marginTop="16dp"
            android:backgroundTint="#444444"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

</RelativeLayout>