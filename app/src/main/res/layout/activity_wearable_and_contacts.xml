<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 🔵 Wearable Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            android:backgroundTint="#1A1A1A">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wearable"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Connect your smartwatch or wearable device for instant SOS alerts."
                    android:textColor="#BBBBBB"
                    android:textSize="14sp"
                    android:layout_marginTop="8dp"/>

                <Button
                    android:id="@+id/btnConnectWearable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Connect Wearable"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#1E88E5"
                    android:textColor="#FFFFFF"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 🔴 Emergency Contacts Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            android:backgroundTint="#1A1A1A">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Emergency Contacts"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <!-- Contact 1 -->
                <EditText
                    android:id="@+id/name1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Name"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#888888"
                    android:backgroundTint="#444444"
                    android:layout_marginTop="12dp"/>

                <EditText
                    android:id="@+id/phone1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Phone Number"
                    android:inputType="phone"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#888888"
                    android:backgroundTint="#444444"
                    android:layout_marginBottom="10dp"/>

                <!-- Contact 2 -->
                <EditText
                    android:id="@+id/name2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Name"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#888888"
                    android:backgroundTint="#444444"/>

                <EditText
                    android:id="@+id/phone2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Phone Number"
                    android:inputType="phone"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#888888"
                    android:backgroundTint="#444444"
                    android:layout_marginBottom="10dp"/>

                <!-- Contact 3 -->
                <EditText
                    android:id="@+id/name3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Name"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#888888"
                    android:backgroundTint="#444444"/>

                <EditText
                    android:id="@+id/phone3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Phone Number"
                    android:inputType="phone"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#888888"
                    android:backgroundTint="#444444"
                    android:layout_marginBottom="10dp"/>

                <!-- Contact 4 -->
                <EditText
                    android:id="@+id/name4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Name"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#888888"
                    android:backgroundTint="#444444"/>

                <EditText
                    android:id="@+id/phone4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Phone Number"
                    android:inputType="phone"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#888888"
                    android:backgroundTint="#444444"/>

                <!-- Save Button -->
                <Button
                    android:id="@+id/btnSaveContacts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Save Contacts"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="#E53935"
                    android:textColor="#FFFFFF"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
